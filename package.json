{
  "name": "pi-compose",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-compose": "./bin/pi-compose.ts",
    "pic": "./bin/pic.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts test/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "ade:dev": "concurrently -k \"npm run ade:ui\" \"wait-on http://127.0.0.1:5173 && npm run ade:desktop\"",
    "ade:ui": "npm run dev --workspace=@pi-compose/workbench",
    "ade:desktop": "COMPOSE_DEV_URL=http://127.0.0.1:5173 npm run dev --workspace=@pi-compose/desktop",
    "ade:build": "npm run build --workspace=@pi-compose/workbench",
    "ade:smoke": "node scripts/ade-fork-smoke.mjs",
    "ade:start": "npm run ade:build && npm run dev --workspace=@pi-compose/desktop",
    "ade:check": "tsc --noEmit -p packages/compose-workbench/tsconfig.json && node --check packages/compose-core/src/index.mjs && node --check apps/compose-desktop/src/main.mjs && node --check apps/compose-desktop/src/preload.cjs"
  },
  "pi": {
    "extensions": [
      "extensions/compose.ts"
    ]
  },
  "dependencies": {
    "zod": "4.6.5",
    "@earendil-works/pi-tui": "1.4.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^22.18.0",
    "typescript": "~5.8.3",
    "@earendil-works/pi-ai": "1.4.0",
    "concurrently": "^9.0.0",
    "wait-on": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  },
  "workspaces": [
    "packages/compose-core",
    "packages/compose-workbench",
    "apps/compose-desktop"
  ]
}
