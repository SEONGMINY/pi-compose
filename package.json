{
  "name": "pi-compose",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-compose": "./bin/pi-compose.ts",
    "pic": "./bin/pic.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts test/*.test.mjs",
    "check": "npm run typecheck && npm test"
