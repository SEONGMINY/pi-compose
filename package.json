{
  "name": "pi-compose",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-compose": "./bin/pi-compose.ts",
    "pic": "./bin/pic.mjs",
    "pic-orca": "./bin/pic-orca.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "test:orca": "node --test test/orca-foundation.test.mjs test/orca-real-pi.test.mjs",
    "orca:prepare": "node scripts/orca-upstream.mjs prepare",
    "orca:dev": "node scripts/orca-upstream.mjs dev",
    "orca:info": "node scripts/orca-upstream.mjs info"
  },
  "pi": {
    "extensions": [
      "extensions/compose.ts"
    ]
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^22.18.0",
    "typescript": "~5.8.3",
    "@earendil-works/pi-ai": "1.4.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  }
}
